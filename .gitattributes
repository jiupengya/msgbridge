# 统一换行处理：源码按内容自动判断，脚本固定各自的换行符
* text=auto

# Gradle/Kotlin/Shell 脚本必须是 LF，否则在 Linux / WSL 下执行会报 bad interpreter
*.sh    text eol=lf
gradlew text eol=lf
*.kt    text eol=lf

# Windows 批处理与 PowerShell 用 CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# 二进制文件不做换行转换
*.png   binary
*.jpg   binary
*.ico   binary
*.jar   binary
*.apk   binary
*.exe   binary
*.dll   binary
