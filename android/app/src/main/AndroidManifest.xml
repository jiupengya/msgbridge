<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 网络与连接 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 前台服务保活（参考 android-screen-off-survival） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 读取勿扰（免打扰）状态：免打扰开启时暂停推送 -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!--
      蓝牙：电脑通过 BLE 让手机打开 / 切换 WiFi 的带外通道。
      WiFi 断开时 TCP 已经不可用，只有蓝牙还能把指令送进来。
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADVERTISE"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />

    <!--
      「显示在其他应用的上层」（悬浮窗）。
      不是用来画悬浮窗的：电脑上点一条通知要在手机上打开对应应用，走的是
      「从后台启动界面」。Android 15 起系统一律拦这种启动，唯一的用户可授权
      豁免就是这条权限（系统日志里叫 BAL_ALLOW_SAW_PERMISSION）。
      没有它的话点击会被系统静默丢弃，应用连异常都收不到。
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
      包可见性：Android 11 起应用默认「看不见」别的应用，
      getLaunchIntentForPackage() 会直接返回 null，按包名打开应用就失效了。
      这里只声明「带桌面入口的应用」，够用，也不必申请敏感的 QUERY_ALL_PACKAGES。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MessageBridge">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 常驻前台服务：保活 TCP 长连接 -->
        <service
            android:name=".service.BridgeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="持续保持与 Windows 电脑的消息推送长连接并监听通知" />
        </service>

        <!-- 控制中心（下拉通知栏）快捷开关：一键开关推送服务 -->
        <service
            android:name=".service.BridgeTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_notify"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- 通知监听服务（系统绑定） -->
        <service
            android:name=".service.NotificationListener"
            android:exported="true"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
          Shizuku：用户已在手机上装了 Shizuku（adb 启动的 shell 服务端），
          通过它执行 `cmd wifi`，才能在普通应用权限下真正开关 / 切换 WiFi。
        -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false" />

        <!-- 开机自启 -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
