<?xml version="1.0" encoding="utf-8"?>
<!-- Project-level NuGet config: ignore machine-wide invalid local sources / fallback folders, use nuget.org only. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
