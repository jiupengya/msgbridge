<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MessageBridge.SnapshotWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:MessageBridge.Core">

    <!--
      无边框窗口：圆角靠 SetWindowRgn 裁（见 WindowScale.ApplyRoundCorners），背景交给 Mica。
      不要加 BorderThickness/BorderBrush：深色主题下 SurfaceStrokeColor 是半透明白，
      在 150% 缩放下就是那圈很扎眼的「白边」。
    -->
    <Border CornerRadius="8" Background="Transparent">

        <Grid x:Name="Root">
            <Grid.KeyboardAccelerators>
                <KeyboardAccelerator Key="Escape" Invoked="OnEscape" />
            </Grid.KeyboardAccelerators>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Padding="12,6,6,6">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                            HorizontalAlignment="Left">
                    <FontIcon Glyph="&#xE8BD;" FontSize="13"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="手机实时通知" FontSize="14" FontWeight="SemiBold" />
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="3" Padding="5,0" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText" Text="未连接" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </Border>
                </StackPanel>

                <Button x:Name="CloseButton" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="28" Height="26" Padding="0" Background="Transparent"
                        BorderThickness="0" Click="OnCloseClicked"
                        ToolTipService.ToolTip="关闭（Esc）">
                    <FontIcon Glyph="&#xE711;" FontSize="10" />
                </Button>
            </Grid>

            <!-- 分隔线 -->
            <Border Grid.Row="1" Height="1"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!-- 开关与操作 -->
            <Grid Grid.Row="2" Padding="12,6">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                            HorizontalAlignment="Left">
                    <CheckBox x:Name="ToastSwitch" Content="电脑气泡" MinWidth="0"
                              Checked="OnToastChanged" Unchecked="OnToastChanged" />
                    <CheckBox x:Name="DndSwitch" Content="手机勿扰" MinWidth="0"
                              Checked="OnDndChecked" Unchecked="OnDndUnchecked" />
                </StackPanel>
                <Button x:Name="ClearButton" Content="清空" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Click="OnClearClicked"
                        ToolTipService.ToolTip="清空手机通知栏" />
            </Grid>

            <!-- 快照列表 -->
            <Grid Grid.Row="3">
                <ListView x:Name="SnapshotList" SelectionMode="None"
                          ItemContainerTransitions="{x:Null}" Padding="4,2">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="6,0" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="core:SnapshotItem">
                            <Grid Padding="4,7" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 图标尺寸对齐 Windows 通知卡片里的 appLogoOverride（48 DIP） -->
                                <Border Width="48" Height="48" CornerRadius="10"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        VerticalAlignment="Top">
                                    <Image Source="{x:Bind IconImage, Mode=OneWay}"
                                           Width="40" Height="40" Stretch="UniformToFill" />
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{x:Bind HeaderText, Mode=OneWay}"
                                               Style="{StaticResource ItemTitleStyle}" />
                                    <TextBlock Text="{x:Bind Content, Mode=OneWay}"
                                               Style="{StaticResource ItemBodyStyle}"
                                               TextWrapping="Wrap" TextTrimming="None" MaxLines="2" />
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="{x:Bind TimeText, Mode=OneWay}"
                                           Style="{StaticResource HintTextStyle}"
                                           VerticalAlignment="Top" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- 空状态 -->
                <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="6" IsHitTestVisible="False">
                    <FontIcon Glyph="&#xE7F4;" FontSize="20"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="手机当前没有通知" FontSize="11"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Grid>

            <!-- 底部提示 -->
            <Border Grid.Row="4" Padding="12,5"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0">
                <TextBlock x:Name="FooterText" Style="{StaticResource HintTextStyle}" FontSize="11"
                           Text="点面板外面或按 Esc 收起" />            </Border>
        </Grid>
    </Border>
</Window>
