<Window x:Class="MessageBridge.SnapshotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="手机实时通知"
        Width="380" Height="480"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="White">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Border BorderBrush="#D9DCE0" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <Border Grid.Row="0" Background="#F7F8FA" Padding="12,8"
                    BorderBrush="#E5E6EB" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="False">
                    <TextBlock Text="手机实时通知" FontSize="14" FontWeight="SemiBold"
                               Foreground="#1F2329" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" DockPanel.Dock="Right" FontSize="11"
                               Foreground="#86909C" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- 开关与操作 -->
            <Border Grid.Row="1" Padding="12,8"
                    BorderBrush="#E5E6EB" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="False">
                    <Button x:Name="ClearButton" DockPanel.Dock="Right" Content="清空手机通知"
                            Padding="8,2" VerticalAlignment="Center" Click="OnClearClicked"/>
                    <CheckBox x:Name="ToastSwitch" DockPanel.Dock="Left" Content="电脑气泡"
                              VerticalAlignment="Center"
                              Checked="OnToastChanged" Unchecked="OnToastChanged"/>
                    <CheckBox x:Name="DndSwitch" DockPanel.Dock="Left" Content="手机勿扰"
                              Margin="16,0,0,0" VerticalAlignment="Center"
                              Checked="OnDndChanged" Unchecked="OnDndChanged"/>
                </DockPanel>
            </Border>

            <!-- 快照列表 -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,4">
                <StackPanel>
                    <TextBlock x:Name="EmptyText" Text="手机当前没有通知"
                               Foreground="#A8ADB4" FontSize="12"
                               HorizontalAlignment="Center" Margin="0,40,0,0"/>
                    <ItemsControl x:Name="SnapshotList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="12,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{Binding IconImage}" Width="28" Height="28"
                                           Stretch="UniformToFill" VerticalAlignment="Top"/>
                                    <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Source}" FontSize="12"
                                                       FontWeight="SemiBold" Foreground="#1F2329"/>
                                            <Border Background="#F2F3F5" CornerRadius="3"
                                                    Padding="4,0" Margin="6,0,0,0"
                                                    Visibility="{Binding IsOngoing, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="常驻" FontSize="10" Foreground="#86909C"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="12"
                                                   Foreground="#4E5969" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Content}" FontSize="12"
                                                   Foreground="#86909C" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontSize="11"
                                               Foreground="#A8ADB4" VerticalAlignment="Top"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- 底部提示 -->
            <Border Grid.Row="3" Background="#FAFBFC" Padding="12,6"
                    BorderBrush="#E5E6EB" BorderThickness="0,1,0,0">
                <TextBlock Text="仅显示手机当前仍存在的通知，断开连接后清空" FontSize="11"
                           Foreground="#A8ADB4" TextTrimming="CharacterEllipsis"/>
            </Border>
        </Grid>
    </Border>
</Window>
