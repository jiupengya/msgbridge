<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MessageBridge.SnapshotWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:MessageBridge.Core">

    <!-- 无边框窗口：圆角靠 DWM 裁，背景和主窗口一样用 Mica，视觉上是一套 -->
    <Border BorderThickness="1" CornerRadius="8"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            Background="Transparent">

        <Grid x:Name="Root">
            <Grid.KeyboardAccelerators>
                <KeyboardAccelerator Key="Escape" Invoked="OnEscape" />
            </Grid.KeyboardAccelerators>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Padding="14,6,8,6">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                            HorizontalAlignment="Left">
                    <FontIcon Glyph="&#xE8BD;" FontSize="14"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="手机实时通知" FontSize="13" FontWeight="SemiBold" />
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="3" Padding="5,0" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText" Text="未连接" FontSize="10"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </Border>
                </StackPanel>

                <Button x:Name="CloseButton" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="30" Height="28" Padding="0" Background="Transparent"
                        BorderThickness="0" Click="OnCloseClicked"
                        ToolTipService.ToolTip="关闭（Esc）">
                    <FontIcon Glyph="&#xE711;" FontSize="11" />
                </Button>
            </Grid>

            <!-- 分隔线 -->
            <Border Grid.Row="1" Height="1"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!-- 开关与操作 -->
            <Grid Grid.Row="2" Padding="14,6">
                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center"
                            HorizontalAlignment="Left">
                    <CheckBox x:Name="ToastSwitch" Content="电脑气泡" MinWidth="0"
                              Checked="OnToastChanged" Unchecked="OnToastChanged" />
                    <CheckBox x:Name="DndSwitch" Content="手机勿扰" MinWidth="0"
                              Checked="OnDndChanged" Unchecked="OnDndChanged" />
                </StackPanel>
                <Button x:Name="ClearButton" Content="清空手机通知" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Click="OnClearClicked" />
            </Grid>

            <!-- 快照列表 -->
            <Grid Grid.Row="3">
                <ListView x:Name="SnapshotList" SelectionMode="None"
                          ItemContainerTransitions="{x:Null}" Padding="6,2">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="8,0" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="core:SnapshotItem">
                            <Grid Padding="4,8" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="32" Height="32" CornerRadius="7"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        VerticalAlignment="Top">
                                    <Image Source="{x:Bind IconImage, Mode=OneWay}"
                                           Width="26" Height="26" Stretch="UniformToFill" />
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock Text="{x:Bind Source, Mode=OneWay}"
                                               Style="{StaticResource ItemTitleStyle}" />
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                               Style="{StaticResource ItemBodyStyle}"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind Content, Mode=OneWay}"
                                               Style="{StaticResource ItemBodyStyle}"
                                               TextWrapping="Wrap" TextTrimming="None" MaxLines="2" />
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="{x:Bind TimeText, Mode=OneWay}"
                                           Style="{StaticResource HintTextStyle}"
                                           FontSize="11" VerticalAlignment="Top" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- 空状态 -->
                <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="8" IsHitTestVisible="False">
                    <FontIcon Glyph="&#xE7F4;" FontSize="24"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="手机当前没有通知" FontSize="12"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Grid>

            <!-- 底部提示 -->
            <Border Grid.Row="4" Padding="14,6"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0">
                <TextBlock Style="{StaticResource HintTextStyle}"
                           Text="只显示手机通知栏里还挂着的通知 · 点面板外面或按 Esc 收起" />
            </Border>
        </Grid>
    </Border>
</Window>
