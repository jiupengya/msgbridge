<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MessageBridge.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:MessageBridge.Core">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 自定义标题栏（拖动区） -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Padding="16,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE8BD;" FontSize="16"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="Message" FontSize="14" FontWeight="SemiBold" />
            </StackPanel>
            <TextBlock x:Name="PortText" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Margin="0,0,140,0"
                       Style="{StaticResource HintTextStyle}" />
        </Grid>

        <!-- 工具行 -->
        <Grid Grid.Row="1" Padding="16,8,16,12">
            <TextBlock x:Name="CountText" VerticalAlignment="Center"
                       Style="{StaticResource HintTextStyle}" />
            <Button x:Name="ClearButton" Content="清空记录" HorizontalAlignment="Right"
                    Click="OnClearClicked" />
        </Grid>

        <!-- 消息列表 -->
        <ListView x:Name="MessageList" Grid.Row="2" Margin="8,0,8,0"
                  SelectionMode="None"
                  ItemContainerTransitions="{x:Null}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="8,0" />
                    <Setter Property="Margin" Value="0,1" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="core:MessageItem">
                    <Grid Padding="8,10" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 应用图标 -->
                        <Border Width="36" Height="36" CornerRadius="8"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <Image Source="{x:Bind IconImage}"
                                   Width="28" Height="28"
                                   Stretch="UniformToFill" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind Source}"
                                           Style="{StaticResource ItemTitleStyle}" />
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="3" Padding="5,0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind TypeText}" FontSize="10"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{x:Bind Title}"
                                       Style="{StaticResource ItemBodyStyle}"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{x:Bind Content}"
                                       Style="{StaticResource ItemBodyStyle}" />
                        </StackPanel>

                        <TextBlock Grid.Column="2" Text="{x:Bind TimeText}"
                                   Style="{StaticResource HintTextStyle}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 底部提示 -->
        <TextBlock Grid.Row="3" Margin="16,10,16,12"
                   Style="{StaticResource HintTextStyle}"
                   Text="提示：关闭窗口会最小化到托盘，推送服务继续运行。手机端需与电脑处于同一局域网。" />
    </Grid>
</Window>
