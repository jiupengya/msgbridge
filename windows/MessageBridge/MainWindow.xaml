<Window x:Class="MessageBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Message · 手机消息推送"
        Width="920" Height="620"
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F7">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题行 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Message"
                       Foreground="#1F2329"/>
            <TextBlock x:Name="PortText" DockPanel.Dock="Right"
                       VerticalAlignment="Center" Foreground="#86909C" FontSize="12"/>
        </DockPanel>

        <!-- 工具行 -->
        <DockPanel Grid.Row="1" Margin="0,0,0,8" LastChildFill="False">
            <TextBlock x:Name="CountText" DockPanel.Dock="Left" VerticalAlignment="Center"
                       Foreground="#86909C" FontSize="12"/>
            <Button DockPanel.Dock="Right" Content="清空记录" Padding="12,4"
                    Click="OnClearClicked"/>
        </DockPanel>

        <!-- 消息列表 -->
        <ListView x:Name="MessageList" Grid.Row="2"
                  BorderBrush="#E5E6EB" BorderThickness="1"
                  Background="White"
                  VirtualizingPanel.IsVirtualizing="True">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="时间" Width="140"
                                    DisplayMemberBinding="{Binding TimeText}"/>
                    <GridViewColumn Header="类型" Width="56"
                                    DisplayMemberBinding="{Binding TypeText}"/>
                    <GridViewColumn Header="来源" Width="190">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Image Source="{Binding IconImage}" Width="26" Height="26"
                                           Stretch="UniformToFill" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Source}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="内容" Width="450">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                               Margin="0,2" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Content}"
                                               Margin="0,0,0,2" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- 底部提示 -->
        <TextBlock Grid.Row="3" Margin="0,8,0,0" Foreground="#86909C" FontSize="12"
                   Text="提示：关闭窗口会最小化到托盘，推送服务继续运行。手机端需与电脑处于同一局域网。"/>
    </Grid>
</Window>
