<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MessageBridge.PairWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" RowSpacing="12" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="收到配对请求" FontSize="20" FontWeight="SemiBold" />

        <TextBlock Grid.Row="1" x:Name="DeviceText" FontSize="13"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap" />

        <Border Grid.Row="2" Padding="16" CornerRadius="8"
                Background="{ThemeResource AccentFillColorDefaultBrush}">
            <StackPanel Spacing="6">
                <TextBlock Text="请在手机上输入以下 PIN 码完成配对（10 分钟内有效）"
                           FontSize="12" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                <TextBlock x:Name="PinText" FontSize="36" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            </StackPanel>
        </Border>

        <Button Grid.Row="3" x:Name="RejectButton" Content="拒绝"
                HorizontalAlignment="Right" Padding="20,6" Click="OnRejectClicked" />
    </Grid>
</Window>
